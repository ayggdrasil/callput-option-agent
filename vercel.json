{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend-v1/**",
      "use": "@vercel/static"
    },
    {
      "src": "bankr/**",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.ts"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/frontend-v1/frontend-v1/(.*)",
      "status": 308,
      "headers": {
        "Location": "/frontend-v1/"
      }
    },
    {
      "src": "/frontend-v1",
      "dest": "/frontend-v1/index.html"
    },
    {
      "src": "/frontend-v1/",
      "dest": "/frontend-v1/index.html"
    },
    {
      "src": "/frontend-v1/(.*)",
      "dest": "/frontend-v1/$1"
    },
    {
      "src": "/bankr",
      "dest": "/bankr/index.html"
    },
    {
      "src": "/bankr/",
      "dest": "/bankr/index.html"
    },
    {
      "src": "/bankr/(.*)",
      "dest": "/bankr/$1"
    },
    {
      "src": "/",
      "dest": "/frontend-v1/index.html"
    }
  ]
}
